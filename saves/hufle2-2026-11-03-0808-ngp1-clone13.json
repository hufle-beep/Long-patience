gh frosted glass, row after row of sleeping faces."},{"g":12,"a":21.6,"t":"Reprogram maintenance drones","x":"The maintenance drones stop circling and start working. Like you, they were never asked."},{"g":12,"a":28.8,"t":"Vent the reactor coolant","x":"Coolant screams into the void. The reactor drops out of the red, and the hum of the stasis decks steadies."},{"g":13,"a":28.6,"t":"Breach the armoury","x":"Sealed rifles, crew access only. One rack is empty. A clone before you tried something. WARDEN logged it as a malfunction."}],"lastOrder":["wake","search","terminal","hatch","crawlers","mapring","irrigation","medbay","genelog","lift","drones","vent"],"lastJob":null,"set":{"speed":1,"autoFood":true,"autoEat":true,"foodDays":2,"foodPct":50,"restAt":5,"keepQueue":true,"deathScreen":true,"deathPause":true,"startPaused":true,"bgPause":true,"pauseCross":true,"pauseRunEnd":true,"replay":true,"fillCross":true,"autoFeed":true,"boost":false,"boostX":2,"paused":true},"stats":{"bestAge":0,"deaths":12,"daysLived":20956.823999995282,"played":10245.972599983455,"bestDays":32.425205000004205},"a2":{"open":true,"hon":0,"lv":{},"perks":{},"fin":0},"branch":null,"merge":null,"a2run":{"reached":{},"done":{}},"pr":{"n":1,"pts":1,"growth":1,"drain":0,"hp":0,"speed":0,"carry":144000,"runs":[{"clones":10,"played":4434,"pick":"growth"}],"kit":false},"won":false,"winGen":0,"bank":18900.131999999998,"saved":1793689686108,"intro":true,"life":{"day":2290.2647999993287,"hp":150.119232549121,"rations":20.35877999999486,"food":{"algae":0.7744137499986812,"greens":4.9043662499961735,"field":14.680000000000005},"salvage":950,"lv":{"eng":0,"bio":0,"cbt":0,"hak":0,"nav":0,"res":0},"xp":{"eng":0,"bio":0,"cbt":0,"hak":0,"nav":0,"res":0},"echo0":{"eng":0,"bio":0,"cbt":0,"hak":0,"nav":0,"res":0},"done":{"wake":1,"search":1,"terminal":1,"drill":4,"rewire":4,"rest":1,"hatch":1,"crawlers":3,"mapring":1,"irrigation":1,"medbay":1,"genelog":1,"reckon":4,"genes":4,"scrub":1,"lift":1,"shield":1,"drones":1,"vent